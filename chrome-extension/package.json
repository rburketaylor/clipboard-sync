{
  "name": "clipboard-sync-extension",
  "version": "1.0.0",
  "description": "Chrome extension for clipboard synchronization",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "tests": "vitest run ",
    "tests:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "mock:backend": "node scripts/mock-backend.cjs",
    "zip": "npm run build && cd dist && zip -r ../clipboard-sync-extension.zip ."
  },
  "keywords": [
    "clipboard",
    "sync",
    "chrome",
    "extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/chrome": "^0.1.12",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.2.0"
  },
  "dependencies": {
    "vue": "^3.5.21"
  }
}
